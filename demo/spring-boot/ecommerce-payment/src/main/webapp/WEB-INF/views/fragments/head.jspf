<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>

<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>

<!doctype html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Form & Field — considered essentials for the everyday. A Razorpay test-mode store.">
    <title>Form &amp; Field · Considered essentials</title>
    <link rel="icon" href="<c:url value='/assets/images/mark.svg'/>">
    <link rel="stylesheet" href="<c:url value='/assets/vendor/bootstrap.min.css'/>">
    <link rel="stylesheet" href="<c:url value='/assets/vendor/bootstrap-icons.css'/>">
    <link rel="stylesheet" href="<c:url value='/assets/css/store.css'/>">
</head>

<body data-context="<c:out value='${pageContext.request.contextPath}'/>">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="announcement">A little more intention. A little less ordinary. <span>Free delivery on every order</span><b>TEST MODE · NO REAL MONEY</b></div>
    <header class="site-header">
        <div class="container-fluid page-width header-inner">
            <a class="brand" href="<c:url value='/'/>"><span class="brand-mark">f<span>f</span></span> form &amp; field<span class="brand-dot">®</span></a>
            <nav aria-label="Main navigation">
                <a href="<c:url value='/'/>">The collection</a>
                <a href="<c:url value='/orders'/>">My orders</a>
                <c:if test="${viewer.role eq 'ADMIN'}">
                    <a href="<c:url value='/admin'/>">Studio admin</a>
                </c:if>
            </nav>
            <div class="header-actions">
                <c:choose>
                    <c:when test="${not empty viewer}"><span class="hello">Hi, <c:out value="${viewer.name}" /></span>
                        <form method="post" action="<c:url value='/logout'/>">

                            <%@ include file="csrf.jspf" %>

                            <button class="icon-button" title="Sign out" aria-label="Sign out"><i class="bi bi-box-arrow-right"></i></button>
                        </form>
                    </c:when>
                    <c:otherwise>
                        <a class="icon-button" href="<c:url value='/login'/>" aria-label="Sign in"><i class="bi bi-person"></i></a>
                    </c:otherwise>
                </c:choose>
                <a class="bag-link" href="<c:url value='/cart'/>"><i class="bi bi-bag"></i><span class="bag-label">Bag</span><span class="bag-count"><c:out
                            value="${bagCount}" /></span></a>
            </div>
        </div>
    </header>
    <c:if test="${not empty notice}">
        <div class="container page-width">
            <div class="alert alert-success notice" role="status"><i class="bi bi-check-circle"></i> <c:out value="${notice}" /></div>
        </div>
    </c:if>
    <c:if test="${not empty error}">
        <div class="container page-width">
            <div class="alert alert-danger notice" role="alert"><c:out value="${error}" /></div>
        </div>
    </c:if>
