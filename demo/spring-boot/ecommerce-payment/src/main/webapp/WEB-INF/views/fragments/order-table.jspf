<%@ page pageEncoding="UTF-8" %>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Order</th>
                <th>Placed</th>
                <th>Total</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <c:forEach items="${orders}" var="o">
                <tr>
                    <td><strong>FF–<c:out value="${o.id}" /></strong></td>
                    <td><c:out value="${o.createdAt}" /></td>
                    <td><c:out value="${o.money}" /></td>
                    <td><span class="state state-${o.status}"><c:out value="${o.status}" /></span></td>
                    <td>
                        <a class="text-link" href="<c:url value='/orders/${o.id}'/>">View order ↗</a>
                    </td>
                </tr>
            </c:forEach>
        </tbody>
    </table>
    <c:if test="${empty orders}">
        <div class="empty-state"><i class="bi bi-bag"></i>
            <h3>A fresh start.</h3>
            <p>Your orders will appear here.</p>
            <a class="btn btn-primary" href="<c:url value='/'/>">Explore the collection</a>
        </div>
    </c:if>
</div>
